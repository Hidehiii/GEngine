schemaVersion: 1
type: render-pipeline
format: render-pipeline
payloadEncoding: text
payload: |
    version: 1
    pipelineType: GEngine.Composable
    settings: {label: cool}
    targets:
      - {name: Output, width: 64, height: 96, samples: 4, colors: [RGBA8], depth: D32}
      - {name: LifetimeProbe, width: 8, height: 8, colors: [RGBA8]}
    resources:
      ColorShader: {path: Assets/Shaders/PipelineAssetColor.gasset, type: shader}
      PresentShader: {path: Assets/Shaders/RenderPipelinePresent.gasset, type: shader}
    passes:
      - name: Draw
        type: Example.SolidColor.v1
        settings: {target: Output, shader: ColorShader, red: '0.1', green: '0.3', blue: '0.9'}
      - name: Present
        type: Example.Present.v1
        settings: {target: Output, shader: PresentShader}
