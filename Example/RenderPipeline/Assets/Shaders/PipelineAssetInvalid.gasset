schemaVersion: 1
type: shader
format: shader
payloadEncoding: text
payload: |
    Shader "PipelineAssetIntentionalCompileFailure"
    {
        Pass
        {
            Cull Off
            DepthTest Always
            DepthWrite Off
            BlendOp None
            ColorMask R G B A
            Tag IntentionalFailure
            #pragma vertex vert
            #pragma fragment frag
            Program
            {
                float4 vert(float2 position : POSITION) : SV_POSITION
                {
                    return float4(position, 0.0, 1.0);
                }
                float4 frag() : SV_Target0 { return MissingPipelineColor; }
            }
        }
    }
