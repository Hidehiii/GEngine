schemaVersion: 1
type: shader
format: shader
payloadEncoding: text
payload: |
    Shader "CameraStack"
    {
        Pass
        {
            Cull Off
            DepthTest Less
            DepthWrite On
            BlendOp None
            ColorMask R G B A
            Tag CameraStack
            #pragma vertex vert
            #pragma fragment frag
            Program
            {
                cbuffer CameraData { float4 Color; float4x4 Projection; };
                float4 vert(float3 position : POSITION) : SV_POSITION
                {
                    return mul(Projection, float4(position, 1.0));
                }
                float4 frag() : SV_Target0 { return Color; }
            }
        }
    }
