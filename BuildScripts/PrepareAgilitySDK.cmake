cmake_minimum_required(VERSION 3.24)
file(READ "${CMAKE_CURRENT_LIST_DIR}/AgilitySDK.json" agility_manifest)
string(JSON agility_package GET "${agility_manifest}" PackageVersion)
string(JSON agility_version GET "${agility_manifest}" SDKVersion)
string(JSON agility_archive_hash GET "${agility_manifest}" ArchiveSHA256)
string(JSON agility_count LENGTH "${agility_manifest}" Files)
math(EXPR agility_last "${agility_count} - 1")
set(agility_files)
foreach(index RANGE ${agility_last})
    string(JSON name MEMBER "${agility_manifest}" Files ${index})
    list(APPEND agility_files "${name}")
endforeach()
function(agility_verify directory)
    foreach(name IN LISTS agility_files)
        if(NOT EXISTS "${directory}/${name}")
            message(FATAL_ERROR "Required Agility SDK file is missing: ${directory}/${name}")
        endif()
        string(JSON expected GET "${agility_manifest}" Files "${name}")
        file(SHA256 "${directory}/${name}" actual)
        string(TOUPPER "${actual}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Agility SDK ${agility_package} hash mismatch: ${directory}/${name}")
        endif()
    endforeach()
endfunction()
if(NOT GE_AGILITY_SDK_ROOT)
    set(GE_AGILITY_SDK_ROOT "$ENV{GE_AGILITY_SDK_ROOT}")
endif()
if(NOT GE_AGILITY_SDK_ROOT)
    if(GE_AGILITY_CHECK_ONLY OR GE_AGILITY_DEPLOY_DIR)
        message(FATAL_ERROR "GE_AGILITY_SDK_ROOT is required. Run cmake -P BuildScripts/PrepareAgilitySDK.cmake, then configure its output path with CMake -DGE_AGILITY_SDK_ROOT=... or Premake --agility-sdk=...")
    endif()
    set(GE_AGILITY_SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../dist/d3d12-agility/windows-x86_64/${agility_package}")
endif()
get_filename_component(GE_AGILITY_SDK_ROOT "${GE_AGILITY_SDK_ROOT}" ABSOLUTE)
if(NOT GE_AGILITY_CHECK_ONLY AND NOT GE_AGILITY_DEPLOY_DIR)
    if(NOT GE_AGILITY_ARCHIVE)
        set(GE_AGILITY_ARCHIVE "${CMAKE_CURRENT_LIST_DIR}/../build/downloads/microsoft.direct3d.d3d12.${agility_package}.nupkg")
        file(MAKE_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/../build/downloads")
        file(DOWNLOAD
            "https://api.nuget.org/v3-flatcontainer/microsoft.direct3d.d3d12/${agility_package}/microsoft.direct3d.d3d12.${agility_package}.nupkg"
            "${GE_AGILITY_ARCHIVE}" EXPECTED_HASH "SHA256=${agility_archive_hash}"
            TLS_VERIFY ON TIMEOUT 120 INACTIVITY_TIMEOUT 30)
    endif()
    file(SHA256 "${GE_AGILITY_ARCHIVE}" actual_archive)
    string(TOUPPER "${actual_archive}" actual_archive)
    if(NOT actual_archive STREQUAL agility_archive_hash)
        message(FATAL_ERROR "Agility SDK archive hash mismatch; nothing extracted.")
    endif()
    # Extract only pinned x64 files and licenses into a private staging directory.
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef staging_id)
    set(staging "${CMAKE_CURRENT_LIST_DIR}/../build/agility-prepare/${staging_id}")
    file(MAKE_DIRECTORY "${staging}")
    set(patterns "LICENSE.txt" "LICENSE-CODE.txt")
    foreach(name IN LISTS agility_files)
        if(name MATCHES "\\.dll$")
            list(APPEND patterns "build/native/bin/x64/${name}")
        endif()
    endforeach()
    file(ARCHIVE_EXTRACT INPUT "${GE_AGILITY_ARCHIVE}" DESTINATION "${staging}" PATTERNS ${patterns})
    foreach(name IN LISTS agility_files)
        if(name MATCHES "\\.dll$")
            file(COPY_FILE "${staging}/build/native/bin/x64/${name}" "${staging}/${name}")
        endif()
    endforeach()
    agility_verify("${staging}")
    file(MAKE_DIRECTORY "${GE_AGILITY_SDK_ROOT}")
    foreach(name IN LISTS agility_files)
        file(COPY_FILE "${staging}/${name}" "${GE_AGILITY_SDK_ROOT}/${name}" ONLY_IF_DIFFERENT)
    endforeach()
    file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}/../build/agility-prepare" staging_root)
    file(REAL_PATH "${staging}" staging_absolute)
    cmake_path(IS_PREFIX staging_root "${staging_absolute}" NORMALIZE staging_is_child)
    if(NOT staging_is_child OR staging_absolute STREQUAL staging_root)
        message(FATAL_ERROR "Refusing to remove staging outside the private staging directory")
    endif()
    file(REMOVE_RECURSE "${staging_absolute}")
endif()
agility_verify("${GE_AGILITY_SDK_ROOT}")
if(GE_AGILITY_DEPLOY_DIR)
    file(MAKE_DIRECTORY "${GE_AGILITY_DEPLOY_DIR}")
    foreach(name IN LISTS agility_files)
        file(COPY_FILE "${GE_AGILITY_SDK_ROOT}/${name}" "${GE_AGILITY_DEPLOY_DIR}/${name}" ONLY_IF_DIFFERENT)
    endforeach()
endif()
message(STATUS "Agility SDK ${agility_package} (SDK ${agility_version}) verified: ${GE_AGILITY_SDK_ROOT}")
