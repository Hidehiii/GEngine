schemaVersion: 1
type: shader
format: shader
payloadEncoding: text
payload: |
    Shader "SceneImageColor"
    {
        Pass
        {
            Cull Off
            DepthTest Always
            DepthWrite Off
            Blend SrcAlpha OneMinusSrcAlpha
            BlendOp None
            ColorMask R G B A
            Tag SceneImageColor

            #pragma vertex vert
            #pragma fragment frag

            Program
            {
                cbuffer material
                {
                    float4x4 GE_MATRIX_M;
                    float4 GE_IMAGE_COLOR;
                    float2 GE_IMAGE_TILING;
                };

                Texture2D GE_IMAGE_TEXTURE;
                sampler GE_IMAGE_SAMPLER;

                struct VsInput
                {
                    float3 position : POSITION;
                    float2 uv : TEXCOORD0;
                };

                struct VsOutput
                {
                    float4 position : SV_POSITION;
                    float2 uv : TEXCOORD0;
                };

                VsOutput vert(VsInput input)
                {
                    VsOutput output;
                    output.position = mul(GE_MATRIX_M, float4(input.position, 1.0f));
                    output.uv = input.uv;
                    return output;
                }

                float4 frag(VsOutput input) : SV_Target
                {
                    return GE_IMAGE_TEXTURE.Sample(GE_IMAGE_SAMPLER, input.uv * GE_IMAGE_TILING) * GE_IMAGE_COLOR;
                }
            }
        }
    }
